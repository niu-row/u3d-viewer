<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net35;netstandard2.0</TargetFrameworks>
    <AssemblyName>U3DViewer.Agent.Mono</AssemblyName>
    <RootNamespace>U3DViewer.Agent.Mono</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net35'">
    <DefineConstants>$(DefineConstants);LEGACY_MONO</DefineConstants>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="6.0.0-be.785" />
    <PackageReference Include="BepInEx.Unity.Mono" Version="6.0.0-be.785" />
    <ProjectReference Include="..\U3DViewer.Protocol\U3DViewer.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net35'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    BepInEx.Unity.Mono intentionally compiles against the UnityEngine facade package.
    Do not add target UnityEngine.CoreModule/SceneManagementModule references here:
    modular Unity players can expose the same public types through both the facade and
    concrete modules, which causes CS0433 duplicate-type errors. The target assemblies
    are still inspected and fingerprinted by AgentBuilder for compatibility/cache use.
  -->
</Project>
