<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>U3DViewer.Agent.IL2CPP</AssemblyName>
    <RootNamespace>U3DViewer.Agent.IL2CPP</RootNamespace>
    <Version>0.1.0</Version>
    <UnityReferenceDir Condition="'$(UnityReferenceDir)' == ''">$(MSBuildProjectDirectory)\lib</UnityReferenceDir>
    <UnityCoreReference Condition="'$(UnityCoreReference)' == ''">$(UnityReferenceDir)\UnityEngine.CoreModule.dll</UnityCoreReference>
    <UnitySceneReference Condition="'$(UnitySceneReference)' == ''">$(UnityReferenceDir)\UnityEngine.SceneManagementModule.dll</UnitySceneReference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.785" />
    <ProjectReference Include="..\U3DViewer.Protocol\U3DViewer.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.Core">
      <HintPath>$(UnityCoreReference)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Scene"
               Condition="'$(UnitySceneReference)' != '$(UnityCoreReference)'">
      <HintPath>$(UnitySceneReference)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
