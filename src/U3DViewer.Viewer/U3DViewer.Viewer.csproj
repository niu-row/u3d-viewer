<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>U3DViewer.Viewer</AssemblyName>
    <RootNamespace>U3DViewer.Viewer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <ProjectReference Include="..\U3DViewer.Protocol\U3DViewer.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AgentBuilderMonoSource Include="..\U3DViewer.Agent.Mono\**\*.cs;..\U3DViewer.Agent.Mono\U3DViewer.Agent.Mono.csproj"
                            Exclude="..\U3DViewer.Agent.Mono\bin\**;..\U3DViewer.Agent.Mono\obj\**;..\U3DViewer.Agent.Mono\lib\**" />
    <AgentBuilderIl2CppSource Include="..\U3DViewer.Agent.IL2CPP\**\*.cs;..\U3DViewer.Agent.IL2CPP\U3DViewer.Agent.IL2CPP.csproj"
                             Exclude="..\U3DViewer.Agent.IL2CPP\bin\**;..\U3DViewer.Agent.IL2CPP\obj\**;..\U3DViewer.Agent.IL2CPP\lib\**" />
    <AgentBuilderProtocolSource Include="..\U3DViewer.Protocol\**\*.cs;..\U3DViewer.Protocol\U3DViewer.Protocol.csproj"
                                Exclude="..\U3DViewer.Protocol\bin\**;..\U3DViewer.Protocol\obj\**" />
  </ItemGroup>

  <Target Name="CopyLocalNativeBridge" AfterTargets="Build">
    <PropertyGroup>
      <NativeBridgePath>$(MSBuildProjectDirectory)\..\..\build\native\$(Configuration)\U3DViewer.NativeBridge.dll</NativeBridgePath>
    </PropertyGroup>
    <Copy SourceFiles="$(NativeBridgePath)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NativeBridgePath)')" />
  </Target>

  <Target Name="CopyAgentBuilderSources" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)agent-builder\src\U3DViewer.Agent.Mono;$(OutputPath)agent-builder\src\U3DViewer.Agent.IL2CPP;$(OutputPath)agent-builder\src\U3DViewer.Protocol" />
    <Copy SourceFiles="@(AgentBuilderMonoSource)"
          DestinationFiles="@(AgentBuilderMonoSource->'$(OutputPath)agent-builder\src\U3DViewer.Agent.Mono\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AgentBuilderIl2CppSource)"
          DestinationFiles="@(AgentBuilderIl2CppSource->'$(OutputPath)agent-builder\src\U3DViewer.Agent.IL2CPP\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AgentBuilderProtocolSource)"
          DestinationFiles="@(AgentBuilderProtocolSource->'$(OutputPath)agent-builder\src\U3DViewer.Protocol\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\Directory.Build.props;$(MSBuildProjectDirectory)\..\..\NuGet.Config"
          DestinationFolder="$(OutputPath)agent-builder"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
