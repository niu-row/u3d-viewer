<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>U3DViewer.Viewer</AssemblyName>
    <RootNamespace>U3DViewer.Viewer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <ProjectReference Include="..\U3DViewer.Protocol\U3DViewer.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\U3DViewer.Agent.Mono\bin\$(Configuration)\netstandard2.0\U3DViewer.Agent.Mono.dll"
          Link="payload\Mono\U3DViewer.Agent.Mono.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\U3DViewer.Agent.Mono\bin\$(Configuration)\netstandard2.0\U3DViewer.Agent.Mono.dll')" />
    <None Include="..\U3DViewer.Agent.IL2CPP\bin\$(Configuration)\net6.0\U3DViewer.Agent.IL2CPP.dll"
          Link="payload\IL2CPP\U3DViewer.Agent.IL2CPP.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\U3DViewer.Agent.IL2CPP\bin\$(Configuration)\net6.0\U3DViewer.Agent.IL2CPP.dll')" />
  </ItemGroup>

  <Target Name="CopyLocalNativeBridge" AfterTargets="Build">
    <PropertyGroup>
      <NativeBridgePath>$(MSBuildProjectDirectory)\..\..\build\native\$(Configuration)\U3DViewer.NativeBridge.dll</NativeBridgePath>
    </PropertyGroup>
    <Copy
      SourceFiles="$(NativeBridgePath)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(NativeBridgePath)')" />
  </Target>
</Project>
